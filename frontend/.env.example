# =============================================================================
# VISION AI — Configuración de entorno Frontend (copiar a frontend/.env)
# =============================================================================

# 1. Conexión a Supabase (copiar de Project Settings > API en tu panel de Supabase)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_public_key_de_supabase

# 2. Motor de visión: "demo" (local simulado) o "api" (servidor Python real con OpenCV + YOLO + CNN)
VITE_VISION_MODE=api
VITE_VISION_API_URL=http://localhost:8000

# 3. PRODUCCIÓN (Vercel > Settings > Environment Variables): la URL del backend en Render, sin "/" final.
#    VITE_VISION_API_URL=https://vision-ai-backend.onrender.com
